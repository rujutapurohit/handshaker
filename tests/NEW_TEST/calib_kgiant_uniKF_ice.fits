GCOUNT  =                    1 / one data group (required keyword)              TFIELDS =                    1 / number of fields in each row                   TTYPE1  = 'SN Flux (erg/s/cm^2/A)' / label for field   1                        TFORM1  = '1E      '           / data format of field: 4-byte REAL              EXTNAME = 'SN SED  '           / name of this binary table extension            NBL     =                 2471 / Nubmer of Lambda bins                          LMIN    =                 300. / min Lambda                                     LMAX    =               25000. / max Lambda                                     LBIN    =                  10. / Lambda bin size                                NBT     =                  131 / Nubmer of Trest bins                           TMIN    =                 -30. / min Trest                                      TMAX    =                 100. / max Trest                                      TBIN    =                   1. / Trest bin size                                 END                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             